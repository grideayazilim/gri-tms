# =============================================================================
# BOT SERVİSİ — ÜRETİM AYARLARI
# Kurulum: cp apps/bot/server/.env.prod.example apps/bot/server/.env.prod
#
# Bot-server'a ikinci env_file olarak verilir ve yönetim sunucusunun
# .env.prod'unu ezer. Dosya yoksa koddaki varsayılanlar geçerli olur.
# ACCESS_TOKEN_SECRET buraya yazılmaz; bot onu yönetim sunucusunun
# .env.prod'undan alır, iki servisin aynı anahtarı kullanması gerekiyor.
# =============================================================================

# ── Bot arayüzünün çağrı yapacağı origin (CORS) ──────────────────────────────
# Kullanıcının tarayıcıda gördüğü adres. Her şey nginx arkasında aynı origin'den
# sunulduğu için normalde devreye girmez; yine de doğru yazılmalı.
ALLOWED_ORIGIN=https://SUNUCU_ADRESI

# ── Süre sınırları (dakika) ──────────────────────────────────────────────────
# Sahada ölçülen hız kişi başına ~75 sn, yoğun saatte ~120 sn: 300 kişi ≈ 6-10
# saat, 1000 kişi ≈ 21-33 saat. Kendi hızınızı koşu sonundaki hız özeti log
# satırından okuyun. Değişiklikte build değil, yeniden başlatma yeterli.

# İşin tamamı için üst sınır. Aşılırsa iş durur; ilerleme kayıtlı olduğu için
# tekrar başlatınca kaldığı yerden devam eder.
BOT_MAX_RUN_MINUTES=1440

# Tek relogin denemesinin üst sınırı. Relogin 10 dakikada bir yapılıyor ve
# zaman aşımına uğrayan tek bir relogin işin tamamını durduruyor; loglardaki
# en yavaş relogin süresinin en az iki katını verin.
BOT_RELOGIN_TIMEOUT_MINUTES=5

# Tek kişinin işlenmesi için üst sınır. Aşılırsa o kişi hatalı sayılır ve
# progress'e yazılmaz (tekrar denenir); üst üste 3 kez olursa iş durur.
BOT_PERSON_TIMEOUT_MINUTES=20

# İlerleme durduğunda işi otomatik sonlandırma süresi. 15. dakikada log'a uyarı
# yazılır (bu sabittir), bu değerde iş sonlandırılır.
BOT_WATCHDOG_MINUTES=30

# Bu dört değerden birine 0 verilirse o sınır tamamen kalkar ve ilgili adım
# sonsuza kadar bekler; takılan iş kendini toparlayamaz, arayüzden "Zorla
# Sıfırla" gerekir. Yalnızca gerçek süreleri ölçtükten sonra kullanın.
