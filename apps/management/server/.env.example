# Veritabanı Bilgileri
DB_HOST=localhost
DB_PORT=5432
DB_NAME=timesheet_management_db

# PostgreSQL Docker image standart değişkenleri (docker-compose için gerekli)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SUPER_USER_PASSWORD
POSTGRES_DB=timesheet_management_db

# Veritabanı Kullanıcıları
# Not: DB_SUPER_USER veritabanını oluşturmak ve silmek için kullanılır (superuser yetkisi gerekir).
DB_SUPER_USER=postgres
DB_SUPER_PASSWORD=YOUR_SUPER_USER_PASSWORD

# Uygulama ve Migrasyon Kullanıcıları
DB_APP_USER=app_user
DB_APP_PASSWORD=YOUR_APP_USER_PASSWORD
DB_MIGRATION_USER=migration_user
DB_MIGRATION_PASSWORD=YOUR_MIGRATION_USER_PASSWORD

# Bağlantı URL'leri (Drizzle ve Pool kullanımı için)
DATABASE_URL=postgresql://app_user:YOUR_APP_USER_PASSWORD@localhost:5432/timesheet_management_db
MIGRATION_DATABASE_URL=postgresql://migration_user:YOUR_MIGRATION_USER_PASSWORD@localhost:5432/timesheet_management_db

# Sunucu Ayarları
PORT=3000
NODE_ENV=development

# JWT Secrets (Üretim ortamında mutlaka değiştirilmelidir)
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Cookie Ayarları (HTTP için false, HTTPS varsa true yapılacak)
COOKIE_SECURE=false

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Log seviyesi (debug | info | warn | error)
LOG_LEVEL=debug
