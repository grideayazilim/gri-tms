# ===========================================================================
# LOCAL DEV ORTAMI — server/.env
#
# Bu dosyayı kopyalayıp ".env" olarak kaydedin:
#   cp .env.example .env
#
# NOT: DB_HOST=localhost → Docker konteyneri dışındaki uygulama,
#      konteynerin 5432 portuna localhost üzerinden bağlanır.
# NOT: Şifrelerde $, ' ve \ karakterlerinden kaçının (shell script uyumu).
# ===========================================================================

# ── PostgreSQL Docker image standart değişkenleri ────────────────────────────
# Docker init scripti (01-init.sh) bu değerleri kullanarak DB ve kullanıcıları oluşturur.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_password

# ── Veritabanı bağlantı bilgileri ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=timesheet_management_db

# ── Superuser (DB oluşturma/silme) ───────────────────────────────────────────
DB_SUPER_USER=postgres
DB_SUPER_PASSWORD=postgres_local_password

# ── Uygulama kullanıcısı (SELECT/INSERT/UPDATE/DELETE) ───────────────────────
DB_APP_USER=app_user
DB_APP_PASSWORD=app_local_password

# ── Migration kullanıcısı (DDL — tablo oluşturma/değiştirme) ────────────────
DB_MIGRATION_USER=migration_user
DB_MIGRATION_PASSWORD=migration_local_password

# ── Bağlantı URL'leri (Drizzle ORM için) ────────────────────────────────────
DATABASE_URL=postgresql://app_user:app_local_password@localhost:5432/timesheet_management_db
MIGRATION_DATABASE_URL=postgresql://migration_user:migration_local_password@localhost:5432/timesheet_management_db

# ── Sunucu ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT Secrets ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=dev_access_secret_change_in_production
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_in_production

# ── Cookie (HTTP için false, HTTPS varsa true) ──────────────────────────────
COOKIE_SECURE=false

# ── Frontend URL ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Log seviyesi (debug | info | warn | error) ──────────────────────────────
LOG_LEVEL=debug
