# ===========================================================================
# PRODUCTION ORTAMI — server/.env.prod
# Bu dosyayı kopyalayıp ".env.prod" olarak kaydedin ve TÜM değerleri doldurun.
# UYARI: Gerçek gizli anahtarlar kullanın. Bu dosyayı asla Git'e eklemeyin.
# NOT: Şifrelerde $, ' ve \ karakterlerinden kaçının (shell script uyumu).
# ===========================================================================

# ── PostgreSQL Docker image standart değişkenleri ────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GUCLU_SUPERUSER_SIFRESI_DEGISTIR
POSTGRES_DB=timesheet_management_db

# ── Veritabanı bağlantı bilgileri ────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=timesheet_management_db

DB_SUPER_USER=postgres
DB_SUPER_PASSWORD=GUCLU_SUPERUSER_SIFRESI_DEGISTIR

DB_APP_USER=app_user
DB_APP_PASSWORD=GUCLU_APP_SIFRESI_DEGISTIR

DB_MIGRATION_USER=migration_user
DB_MIGRATION_PASSWORD=GUCLU_MIGRATION_SIFRESI_DEGISTIR

# ── Bağlantı URL'leri (DB_HOST=postgres — Docker network adı) ────────────────
DATABASE_URL=postgresql://app_user:GUCLU_APP_SIFRESI_DEGISTIR@postgres:5432/timesheet_management_db
MIGRATION_DATABASE_URL=postgresql://migration_user:GUCLU_MIGRATION_SIFRESI_DEGISTIR@postgres:5432/timesheet_management_db

# ── Sunucu ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── JWT (min 256-bit — aşağıdaki komutla üretin, iki token için farklı değer) ─
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=RASTGELE_GUCLU_SECRET_EN_AZ_64_BYTE_HEX_DEGISTIR
REFRESH_TOKEN_SECRET=FARKLI_RASTGELE_GUCLU_SECRET_EN_AZ_64_BYTE_HEX_DEGISTIR

# ── Cookie (HTTPS zorunlu — production'da mutlaka true olmalı) ──────────────
# HTTPS yoksa false olmalı; aksi halde tarayıcı cookie'yi kaydetmez ve kimse
# giriş yapamaz (login 200 döner, sonraki istek 401).
COOKIE_SECURE=true

# ── Frontend URL (domain veya sunucu IP'si) ──────────────────────────────────
# HTTPS kurulduktan sonra https:// olmalı (CORS origin kontrolü)
FRONTEND_URL=https://SUNUCU_ADRESI

# ── Log seviyesi ─────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── İlk admin şifresi ──────────────────────────────────────────────────
# Verilmezse '1234' kullanılır. Her iki durumda da ilk girişte şifre değişimi
# zorunludur. Rastgele bir şifre üretmek için:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
SEED_ADMIN_PASSWORD=

# ── Self-service kayıt ─────────────────────────────────────────────────
# Kadro oturduktan sonra 'false' yapın; kullanıcıları admin doğrudan oluştursun.
# Dışa açık kurulumda 'false' önerilir.
ALLOW_SELF_REGISTRATION=true

# ── Giriş deneme sınırı ─────────────────────────────────────────────────
# IP başına 15 dakikalık sınır. Okulda herkes tek bir dış IP'nin arkasında
# olduğu için dar tutmayın; brute force'a karşı asıl koruma kullanıcı adı
# başına işleyen sayaçtır (15 dakikada 10, sabit).
LOGIN_IP_RATE_LIMIT_MAX=100

# IP sayacından muaf adresler — virgülle ayrılmış IP / IPv4 CIDR. Kullanıcı adı
# sayacı muaf tutulmaz, iç ağdan gelen deneme de sınırlıdır.
# Örnek: LOGIN_RATE_LIMIT_ALLOWLIST=10.0.0.0/8,192.168.1.0/24
LOGIN_RATE_LIMIT_ALLOWLIST=

# ── Bot servisi ────────────────────────────────────────────────────────
# Bot bu dosyadan yalnızca ACCESS_TOKEN_SECRET'ı okur. Origin ve süre sınırları
# apps/bot/server/.env.prod dosyasına yazılır; buraya yazılanlar etkisiz kalır.
