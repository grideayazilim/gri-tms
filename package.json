{
  "name": "timesheet-management-system",
  "private": true,
  "workspaces": [
    "apps/management/*",
    "apps/bot/*"
  ],
  "scripts": {
    "dev:shared": "npm run dev -w @timesheet/shared",
    "dev:server": "npm run dev -w management-server",
    "dev:client": "npm run dev -w management-client",
    "dev:bot-server": "npm run dev -w bot-server",
    "dev:bot-client": "npm run start -w bot-client",
    "dev:management": "concurrently --kill-others -c \"cyan,magenta\" -n \"SERVER,CLIENT\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:bot": "concurrently --kill-others -c \"blue,yellow\" -n \"BOT-SRV,BOT-CLI\" \"npm run dev:bot-server\" \"npm run dev:bot-client\"",
    "dev:all": "concurrently --kill-others -c \"cyan,magenta,blue,yellow\" -n \"SERVER,CLIENT,BOT-SRV,BOT-CLI\" \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:bot-server\" \"npm run dev:bot-client\"",
    "build:shared": "npm run build -w @timesheet/shared",
    "build:management": "npm run build:shared && npm run build -w management-server && npm run build -w management-client",
    "build:bot": "npm run build -w bot-client",
    "build:all": "npm run build:management && npm run build:bot",
    "typecheck": "npm run typecheck -w @timesheet/shared && npm run typecheck -w management-server && npm run typecheck -w management-client",
    "lint": "npm run lint -w management-server; npm run lint -w management-client",
    "db:migrate": "npm run db:migrate -w management-server",
    "db:seed": "npm run db:seed -w management-server",
    "db:seed:demo": "npm run db:seed:demo -w management-server",
    "db:generate": "npm run db:generate -w management-server"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.60.4",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.0.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.4",
    "type-coverage": "^2.29.7",
    "typescript": "^5.8.3"
  }
}
