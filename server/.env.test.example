# ===========================================================================
# TEST ORTAMI — server/.env.test
# Bu dosyayı kopyalayıp ".env.test" olarak kaydedin ve değerleri doldurun.
# NOT: Şifrelerde $, ' ve \ karakterlerinden kaçının (shell script uyumu).
# ===========================================================================

# ── PostgreSQL Docker image standart değişkenleri ────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test_super_password
POSTGRES_DB=timesheet_management_db

# ── Veritabanı bağlantı bilgileri ────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=timesheet_management_db

DB_SUPER_USER=postgres
DB_SUPER_PASSWORD=test_super_password

DB_APP_USER=app_user
DB_APP_PASSWORD=test_app_password

DB_MIGRATION_USER=migration_user
DB_MIGRATION_PASSWORD=test_migration_password

# ── Bağlantı URL'leri (DB_HOST=postgres — Docker network adı) ────────────────
DATABASE_URL=postgresql://app_user:test_app_password@postgres:5432/timesheet_management_db
MIGRATION_DATABASE_URL=postgresql://migration_user:test_migration_password@postgres:5432/timesheet_management_db

# ── Sunucu ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=test

# ── JWT ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=test_access_token_secret_change_me
REFRESH_TOKEN_SECRET=test_refresh_token_secret_change_me

# ── Cookie ───────────────────────────────────────────────────────────────────
COOKIE_SECURE=false

# ── Frontend URL (nginx port 80) ─────────────────────────────────────────────
FRONTEND_URL=http://localhost

# ── Log seviyesi ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
